---
import { siteConfig } from "../config";
const hasCertifications = siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900 leading-tight">
              Licenses &<br />Certifications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-4 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {siteConfig.certifications.map((cert) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow duration-300">
                  {cert.link ? (
                    <a href={cert.link} target="_blank" rel="noopener noreferrer" class="hover:underline">
                      <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-2">
                        {cert.name}
                        <svg class="inline-block w-4 h-4 ml-1 mb-1 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </h3>
                    </a>
                  ) : (
                    <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-2">
                      {cert.name}
                    </h3>
                  )}
                  <p
                    class="text-sm sm:text-base font-medium"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {cert.issuer}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
